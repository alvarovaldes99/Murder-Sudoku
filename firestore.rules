rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // User validation
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'name', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
             data.createdAt == request.time;
    }

    match /users/{userId} {
      // allow fetching validation
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if false; // No list for users at the moment
      
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       userId == request.auth.uid &&
                       isValidUser(incoming());
      
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       userId == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name']) &&
                       incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 50;
                       
      allow delete: if false; // Users shouldn't be deleted purely from firestore
    }

    // GameRecord validation
    function isValidGameRecord(data) {
      return data.keys().hasAll(['userId', 'seed', 'difficulty', 'timeMs', 'solvedAt']) &&
             data.keys().size() == 5 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.seed is number &&
             data.difficulty is string && data.difficulty.size() > 0 && data.difficulty.size() <= 20 &&
             data.timeMs is number && data.timeMs > 0 &&
             data.solvedAt == request.time;
    }

    match /game_records/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId) && existing().userId == request.auth.uid;
      
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(recordId) &&
                       isValidGameRecord(incoming()) &&
                       exists(/databases/$(database)/documents/users/$(incoming().userId)); // atomic/fk check
                       
      allow update: if isSignedIn() &&
                       isValidId(recordId) &&
                       existing().userId == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['duelId']) &&
                       incoming().duelId is string && incoming().duelId.size() > 0 && incoming().duelId.size() <= 128;
      
      allow delete: if false;
    }

    // Duel validation
    function isValidDuel(data) {
      return data.keys().hasAll(['creatorId', 'creatorName', 'seed', 'difficulty', 'creatorTimeMs', 'createdAt']) &&
             data.keys().size() == 6 &&
             data.creatorId is string && data.creatorId.size() > 0 && data.creatorId.size() <= 128 && data.creatorId == request.auth.uid &&
             data.creatorName is string && data.creatorName.size() > 0 && data.creatorName.size() <= 50 &&
             data.seed is number &&
             data.difficulty is string && data.difficulty.size() > 0 && data.difficulty.size() <= 20 &&
             data.creatorTimeMs is number && data.creatorTimeMs > 0 &&
             data.createdAt == request.time;
    }

    match /duels/{duelId} {
      allow get: if isValidId(duelId); // Anyone can fetch a duel
      allow list: if false; // List is generally not needed yet, or could be restricted to creator

      allow create: if isSignedIn() &&
                       isValidId(duelId) &&
                       isValidDuel(incoming()) &&
                       exists(/databases/$(database)/documents/users/$(incoming().creatorId));
      allow update: if false; // Duels are immutable
      allow delete: if false;
      
      // DuelResult validation
      function isValidDuelResult(data, currentDuelId) {
        return data.keys().hasAll(['duelId', 'userId', 'userName', 'timeMs', 'playedAt']) &&
               data.keys().size() == 5 &&
               data.duelId == currentDuelId &&
               data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 && data.userId == request.auth.uid &&
               data.userName is string && data.userName.size() > 0 && data.userName.size() <= 50 &&
               data.timeMs is number && data.timeMs > 0 &&
               data.playedAt == request.time;
      }

      match /results/{resultId} {
        allow get: if isValidId(duelId) && isValidId(resultId);
        // We evaluate existing().duelId against the path param though not strictly required,
        // it's safer to just check the document properties if we needed to, but we just check the path
        allow list: if isValidId(duelId); // Anyone can list results of a specific duel
        
        allow create: if isSignedIn() &&
                         isValidId(duelId) &&
                         isValidId(resultId) &&
                         isValidDuelResult(incoming(), duelId) &&
                         exists(/databases/$(database)/documents/duels/$(duelId)); // Make sure duel exists
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
