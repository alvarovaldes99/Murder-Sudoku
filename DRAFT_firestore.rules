rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // User validation
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'name', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
             data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if false; // No list for users at the moment
      
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       userId == request.auth.uid &&
                       isValidUser(incoming());
      
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       userId == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name']) &&
                       incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 50;
                       
      allow delete: if false; // Users shouldn't be deleted purely from firestore
    }

    // GameRecord validation
    function isValidGameRecord(data) {
      return data.keys().hasAll(['userId', 'seed', 'difficulty', 'timeMs', 'solvedAt']) &&
             data.keys().size() == 5 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.seed is number &&
             data.difficulty is string && data.difficulty.size() > 0 && data.difficulty.size() <= 20 &&
             data.timeMs is number && data.timeMs > 0 &&
             data.solvedAt == request.time;
    }

    match /game_records/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId) && existing().userId == request.auth.uid;
      
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(recordId) &&
                       isValidGameRecord(incoming()) &&
                       exists(/databases/$(database)/documents/users/$(incoming().userId)); // atomic/fk check
                       
      allow update: if false; // Game records are immutable once saved
      allow delete: if false;
    }
  }
}
